{
  "name": "librechat-ui",
  "productName": "LibreChat UI",
  "description": "LibreChat UI is a desktop application for LibreChat",
  "type": "module",
  "version": "1.4.0",
  "author": "@leikoilja",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "app:dist": "electron-builder",
    "app:dist:mac": "electron-builder --mac",
    "app:dist:win": "electron-builder --win",
    "app:dist:linux": "electron-builder --linux",
    "app:dir:linux": "electron-builder --linux dir",
    "verify": "node --check index.js && node --check security.js && node --check login.js && node --check login-preload.cjs && node --check shortcuts.cjs && node --test"
  },
  "build": {
    "appId": "com.librechat-ui",
    "mac": {
      "category": "public.ai.chat.librechat",
      "artifactName": "${productName}-v${version}-mac.${ext}",
      "identity": null
    },
    "win": {
      "artifactName": "${productName}-v${version}-win.${ext}"
    },
    "linux": {
      "target": "snap",
      "artifactName": "${productName}-v${version}-linux.${ext}"
    },
    "publish": "github"
  },
  "devDependencies": {
    "electron": "43.8.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-store": "11.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "**/fast-uri": "3.1.5",
    "**/@xmldom/xmldom": "0.8.13",
    "**/js-yaml": "4.3.1",
    "**/tmp": "0.2.7",
    "**/lodash": "4.18.1",
    "**/@electron/asar/minimatch": "3.1.5",
    "**/@electron/asar/glob/minimatch": "3.1.5",
    "**/dir-compare/minimatch": "3.1.5",
    "**/jake/minimatch": "3.1.5",
    "**/filelist/minimatch": "5.1.9",
    "**/@electron/universal/minimatch": "9.0.9",
    "**/ajv": "8.18.0"
  }
}
